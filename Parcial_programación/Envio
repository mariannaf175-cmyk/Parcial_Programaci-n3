import java.io.Serializable;
import java.util.*;

public abstract class Envio implements Serializable {
    private final String guia;
    private final String remitente;
    private final String destinatario;
    private final String destino;      
    private double peso;
    private double largo, ancho, alto;
    private final double valorDeclarado;
    private EstadoEnvio estado;
    private final List<CambioEstado> historial = new ArrayList<>();

    Envio(String guia, String remitente, String destinatario, String destino,
          double peso, double largo, double ancho, double alto, double valorDeclarado)
            throws GuiaInvalidaException, PesoInvalidoException {
        Validador.validarGuia(guia);
        Validador.validarPeso(peso, pesoMaximo());
        Validador.validarDimensiones(largo, ancho, alto);
        Validador.validarValor(valorDeclarado);
        this.guia = guia;
        this.remitente = remitente;
        this.destinatario = destinatario;
        this.destino = destino;
        this.peso = peso;
        this.largo = largo;
        this.ancho = ancho;
        this.alto = alto;
        this.valorDeclarado = valorDeclarado;
        cambiarEstado(new Registrado());
    }

    // ---- metodos abstractos / sobrescribibles ----
    abstract String tipo();
    abstract double calcularFlete();
    double pesoMaximo() { return 50; }

    // ---- calculos ----
    double pesoVolumetrico() { return (largo * ancho * alto) / 5000.0; }

    int pesoFacturable() { return (int) Math.ceil(Math.max(peso, pesoVolumetrico())); }

    double seguro() { return 0; }   // el estandar no tiene seguro

    double total() { return calcularFlete() + seguro(); }

    // ---- State: delegacin (sin if ni switch sobre el estado) ----
    void enRuta() throws TransicionInvalidaException { estado.enRuta(this); }
    void entregado() throws TransicionInvalidaException { estado.entregado(this); }
    void devuelto() throws TransicionInvalidaException { estado.devuelto(this); }

    void corregirPeso(double nuevoPeso) throws TransicionInvalidaException, PesoInvalidoException {
        estado.corregirPeso(this, nuevoPeso);
    }

    void corregirDimensiones(double l, double a, double h)
            throws TransicionInvalidaException, PesoInvalidoException {
        estado.corregirDimensiones(this, l, a, h);
    }

    void cambiarEstado(EstadoEnvio nuevo) {
        this.estado = nuevo;
        historial.add(new CambioEstado(nuevo.nombre(), LocalDateTime.now()));
    }

    void setPeso(double p) { this.peso = p; }
    void setDimensiones(double l, double a, double h) { this.largo = l; this.ancho = a; this.alto = h; }

    // ---- getters ----
    String getGuia() { return guia; }
    String getRemitente() { return remitente; }
    String getDestinatario() { return destinatario; }
    String getDestino() { return destino; }
    double getPeso() { return peso; }
    double getValorDeclarado() { return valorDeclarado; }
    String getEstado() { return estado.nombre(); }
    List<CambioEstado> getHistorial() { return Collections.unmodifiableList(historial); }
}





