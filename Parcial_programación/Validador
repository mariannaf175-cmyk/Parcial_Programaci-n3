import java.util.regex.Pattern;

public class Validador {
    private static final Pattern GUIA = Pattern.compile("PL-\\d{6}");

    static void validarGuia(String guia) throws GuiaInvalidaException {
        if (guia == null || !GUIA.matcher(guia).matches())
            throw new GuiaInvalidaException("La guia debe ser 'PL-' seguido de 6 numeros (ej. PL-000101).");
    }

    static void validarPeso(double peso, double maximo) throws PesoInvalidoException {
        if (peso <= 0)
            throw new PesoInvalidoException("El peso real debe ser mayor que 0.");
        if (peso > maximo)
            throw new PesoInvalidoException("El peso real no puede superar " + (int) maximo + " kg para este servicio.");
    }

    static void validarDimensiones(double l, double a, double h) throws PesoInvalidoException {
        if (l <= 0 || a <= 0 || h <= 0)
            throw new PesoInvalidoException("Las dimensiones (largo, ancho, alto) deben ser mayores que 0.");
    }

    static void validarValor(double valor) throws PesoInvalidoException {
        if (valor < 0)
            throw new PesoInvalidoException("El valor declarado debe ser mayor o igual a 0.");
    }
}



















